# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is listed in .gitignore.

# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ── PayPal ─────────────────────────────────────────────────────────────────────
# Get from developer.paypal.com → My Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=    # Safe to expose — used in the browser SDK
PAYPAL_CLIENT_SECRET=            # SERVER-SIDE ONLY — never use NEXT_PUBLIC_ prefix
PAYPAL_MODE=live                 # 'sandbox' for testing, 'live' for production

# ── App canonical URL ──────────────────────────────────────────────────────────
# Used for QR codes in live presentations — must be the public domain
NEXT_PUBLIC_APP_URL=https://www.livezapp.com
